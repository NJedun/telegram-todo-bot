# Telegram Bot Token (get from @BotFather)
BOT_TOKEN=your_bot_token_here

# Server Port (default: 3000)
PORT=3000

# WebApp URL (your public URL - use ngrok for local development)
# For local testing with ngrok: https://your-subdomain.ngrok.io
# For production: https://your-domain.com
WEBAPP_URL=https://your-domain.com

# App Password (users must enter this to access the todo list)
APP_PASSWORD=your_secret_password_here

# Firebase Configuration
FIREBASE_API_KEY=your_firebase_api_key
FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=your_sender_id
FIREBASE_APP_ID=your_app_id
